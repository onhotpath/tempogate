# DEV ONLY. Do not copy this file to `.env` as is: the stack refuses to start
# until every secret below is set, and these are intentionally blank.
# Generate a `.env` with fresh random secrets instead:
#
#   ./gen-env.sh > .env
#
# This file only documents the variable names docker-compose.yml reads.

# Required secrets (no defaults; `docker compose up` fails if any is unset).
# HMAC key for the device-flow session cookie: base64url, 32 random bytes.
TEMPOGATE_SESSION_SIGNING_KEY=
# Confidential client secrets (OIDC_CLIENT_SECRETS). TEMPORAL_UI_CLIENT_SECRET
# is shared by tempogate and the temporal-ui container.
TEMPORAL_UI_CLIENT_SECRET=
TEMPOGATE_DEVICE_UI_CLIENT_SECRET=
# Temporal's postgres password.
POSTGRES_PASSWORD=

# Optional, non-secret knobs (defaults shown).
# Email domains allowed to complete SSO. The demo identity must match one of
# these or tempogate's callback returns 403. Comma-separated, exact-match.
# TEMPOGATE_ALLOWED_DOMAINS=example.com
# Identity the bundled mock IdP's one-click consent screen asserts.
# DEMO_EMAIL=alice@example.com
# tempogate log level: debug | info | warn | error.
# LOG_LEVEL=info
